# ── Cloudflare Pages Custom Headers ──

/src/css/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/src/js/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/src/js/core/page-shell.js
  Cache-Control: public, max-age=0, must-revalidate
/src/js/core/i18n.js
  Cache-Control: public, max-age=0, must-revalidate
/src/js/core/i18n-runtime.js
  Cache-Control: public, max-age=0, must-revalidate
/src/js/core/i18n-layout.css
  Cache-Control: public, max-age=0, must-revalidate
/src/css/mobile-shell-fixes.css
  Cache-Control: public, max-age=0, must-revalidate
/src/js/core/pwa-install.js
  Cache-Control: public, max-age=0, must-revalidate

# English application shell: never pin a generated HTML entry or manifest.
/en/*
  Cache-Control: public, max-age=0, must-revalidate
/en/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, s-maxage=86400
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, s-maxage=86400
