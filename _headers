# ── Cloudflare Pages Custom Headers ──

# Versioned & immutable static assets (1 Year Cache)
/src/css/*
  # CSS modules are not content-hashed; keep browser TTL short to avoid stale deployments.
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/src/js/*
  # JS modules are not content-hashed; keep browser TTL short to avoid stale deployments.
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

# Clean HTML pages (Fresh content with instant revalidation)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Service Workers (Never cache)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# AI Context & Agent Discovery Files
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, s-maxage=86400

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, s-maxage=86400
